# Public domain of the catalog. Its DNS record must point at this machine.
AGENTECA_DOMAIN=catalog.example.org

# First administrator, created on first start.
AGENTECA_ADMIN_EMAIL=admin@example.org
# Leave empty to have a random password generated and printed once in the server logs.
AGENTECA_ADMIN_PASSWORD=

# Image version to run. Pin it in production (for example 0.1.0) rather than using latest.
AGENTECA_VERSION=latest
